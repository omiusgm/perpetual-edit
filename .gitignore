# Models are downloaded and checksum-verified by tools/download_models.py
assets/models/*.task
assets/models/*.tflite
assets/models/*.download

# Packaging / duplicate launch artifacts
*.command.zip
run 2.command

# Prevent accidental commits of downloaded reference media anywhere else
*.mp4
*.mov
*.mkv
*.webm
*.mp3
*.m4a
*.wav
